{
  "name": "dsh-desktop",
  "productName": "DeepSeek Harness",
  "version": "0.1.0",
  "description": "DeepSeek Harness desktop shell: an Electron launcher that runs the dsh web backend (spawned with the system Node) and opens the harness GUI in a native window, with git-managed self-upgrades.",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/progress.html','dist/progress.html')\"",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke",
    "pack:dir": "npm run build && electron-builder --mac dir",
    "dist": "npm run build && electron-builder --mac"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "sharp": "0.35.3",
    "typescript": "^6.0.3"
  }
}
